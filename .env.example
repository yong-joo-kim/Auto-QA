# Anthropic Claude API
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Google Gemini
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 모델 선정 근거: docs/decisions/ADR-001-gemini-llm-provider.md (D-1) 참조.
# 2026-09-12 기준 GEMINI_API_KEY로 모델 목록/개별 조회/실제 채점형 구조화 출력 호출로 존재 및
# responseSchema 지원을 실측 확인한 모델(PM 지정). LLM_PROVIDER=gemini일 때 필수이며,
# 값이 비어 있으면 기동 시 실패한다(조용한 기본값 사용을 방지하기 위해 코드에 하드코딩된
# fallback을 두지 않았다 — FR-8.2/AC-6).
# 참고: 실측 중 일시적 고수요(503 UNAVAILABLE)가 관측되었다(재시도로 흡수됨). 503/500이 잦으면
# ADR-001에 기록된 대안 gemini-2.5-flash로 전환을 검토할 것(코드 변경 없이 env만 교체).
GEMINI_MODEL=gemini-3.8-flash
# 아래는 선택 항목이며, 비어 있으면 코드 기본값을 사용한다(FR-2.3).
# 단일 HTTP 호출 타임아웃(ms)
GEMINI_TIMEOUT_MS=60000
# 일시적 오류(429/5xx/네트워크/타임아웃) 재시도 횟수
GEMINI_MAX_RETRIES=2
# 응답 최대 출력 토큰
GEMINI_MAX_OUTPUT_TOKENS=8192
# 샘플링 온도(채점 편차 최소화를 위해 기본 0)
GEMINI_TEMPERATURE=0
# API 베이스 URL 오버라이드 — 테스트 전용(로컬 스텁 서버로 오류 경로 재현). 운영에서는 비워둔다.
GEMINI_API_BASE_URL=
# 사고(thinking) 토큰 예산 — 모델이 지원할 때만 적용. 미설정 시 모델 기본값(thinking 활성)을 사용한다.
# M-4 실측(2026-09-12, gemini-3.8-flash, telecom 14항목 실호출): thinking 활성 상태에서
# thoughtsTokenCount는 약 550~650 토큰, candidatesTokenCount(items+coaching)는 약 960~1030
# 토큰으로 합계 약 1,700~1,900 토큰 — GEMINI_MAX_OUTPUT_TOKENS 기본값(8192) 대비 여유가
# 충분해 절단(MAX_TOKENS) 위험은 낮게 관측되었다(docs/decisions/ADR-001 참조). 평가시트
# 항목 수가 크게 늘거나(14개 초과) coaching 문구가 길어지면 GEMINI_THINKING_BUDGET=0으로
# thinking을 끄는 것을 권장한다(채점 스키마가 이미 구조를 강제하므로 thinking이 점수 품질에
# 미치는 영향은 제한적이다).
GEMINI_THINKING_BUDGET=

# LLM Provider 선택: mock(기본) | anthropic | gemini
LLM_PROVIDER=mock
# Mock LLM 오류 주입 확률(0~1, 테스트 전용, 기본 0)
MOCK_LLM_FAILURE_RATE=0

# apps/api
API_PORT=3000
DATABASE_URL=file:./dev.db

# 웹 출처 제한(CORS + 평가시트 업로드/복원 엔드포인트의 Origin 검증). 쉼표로 구분.
# 미설정 시 로컬 Vite 개발 서버(http://localhost:5173, http://127.0.0.1:5173)만 허용한다.
# 배포 시 실제 웹 주소를 지정할 것. '*'는 모든 출처를 허용하므로 운영에서 사용하지 않는다.
CORS_ORIGINS=http://localhost:5173
# 평가시트 Excel 업로드로 수정된 시트(override)와 개정 이력 저장 경로. 비우면 리포지토리 루트의 data/eval-sheets-override.
# EVAL_SHEETS_DIR을 리포지토리 밖으로 지정했다면 이 값도 반드시 쓰기 가능한 경로로 지정한다.
EVAL_SHEETS_OVERRIDE_DIR=

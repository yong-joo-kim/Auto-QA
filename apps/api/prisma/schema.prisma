// Auto QA — Phase 1 Prisma 스키마
// 원문(rawText)은 어떤 모델/필드에도 저장하지 않는다 (요구사항 §4.4, NFR-1.1).
//
// NOTE: SQLite(prisma 5.x)는 네이티브 Json 컬럼 타입을 지원하지 않으므로,
// 구조화된 값(items/categoryScores/goodPoints 등)은 String에 JSON 직렬화하여 저장하고
// 애플리케이션 레이어(apps/api/src/transcripts/transcripts.service.ts)에서
// JSON.stringify/JSON.parse로 변환한다. 값 자체의 의미/스키마는 §4.4 요구사항과 동일하다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Transcript {
  id         String      @id @default(uuid())
  domainId   String
  maskedText String
  // JSON 직렬화된 TranscriptMetadata, 없으면 null
  metadata   String?
  // Phase 3 FR-4: JSON 직렬화된 MaskingSummary(Record<PiiKind, number>). 원문 조각은
  // 포함하지 않고 종류별 건수만 담는다. Phase 3 이전 저장분은 null(레거시, 소급 계산 불가).
  maskingSummary String?
  createdAt  DateTime    @default(now())
  evaluation Evaluation?

  @@map("transcripts")
}

model Evaluation {
  id               String     @id @default(uuid())
  transcriptId     String     @unique
  transcript       Transcript @relation(fields: [transcriptId], references: [id])
  domainId         String
  evalSheetVersion String
  llmProvider      String
  llmModel         String
  // "completed" | "manual_review" (스코어 검증 실패 후 1회 재시도까지 실패한 경우)
  status            String   @default("completed")
  // JSON 직렬화된 EvaluationItemResult[]
  items             String
  // JSON 직렬화된 CategoryScoreResult[]
  categoryScores    String
  totalScore        Int
  totalMaxScore     Int
  grade             String
  gatingResult      String
  // JSON 직렬화된 FailedGatingItem[]
  failedGatingItems String
  // JSON 직렬화된 string[]
  goodPoints        String
  // JSON 직렬화된 string[]
  improvements      String
  profanityDetected Boolean
  // JSON 직렬화된 ProfanityMatch[]
  profanityMatches  String
  createdAt         DateTime @default(now())

  @@map("evaluations")
}
